#!/bin/sh
# 工作区内的 adb 包装器
# 作用：把 HOME 指到工作区内的 local/adbhome，避免 adb 往 /vol1/@appshare/Harness/.android 写（沙箱会拒）
# 用法：tools/adb devices / connect / shell ...
DIR=$(cd "$(dirname "$0")" && pwd)
# adb 优先用项目自带的 local/platform-tools，否则退回机器级共享目录
ADB="$DIR/../local/platform-tools/adb"
[ -x "$ADB" ] || ADB="${DEVTOOLS:-$HOME/dev-tools}/platform-tools/adb"
export HOME="$DIR/../local/adbhome"
mkdir -p "$HOME/.android" 2>/dev/null || true   # 新克隆的仓库里没有这个目录，adb 自己建不了多级
export ADB_MDNS=0
exec "$ADB" "$@"
